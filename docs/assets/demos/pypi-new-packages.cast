[2.5298, "o", "\u001b[3m                                        Newly Added Packages                                        \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;35m \u001b[0m\u001b[1;35mIndex\u001b[0m\u001b[1;35m \u001b[0m\u2503\u001b[1;32m \u001b[0m\u001b[1;32mName                  \u001b[0m\u001b[1;32m \u001b[0m\u2503\u001b[1;37m \u001b[0m\u001b[1;37mDescription           \u001b[0m\u001b[1;37m \u001b[0m\u2503\u001b[1;34m \u001b[0m\u001b[1;34mLink                 \u001b[0m\u001b[1;34m \u001b[0m\u2503\u001b[1;33m \u001b[0m\u001b[1;33mPublished At  \u001b[0m\u001b[1;33m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[35m \u001b[0m\u001b[35m1.   \u001b[0m\u001b[35"]
[2.5299, "o", "m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mcommitstash           \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mAI-powered git commit \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m10 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mmessage generator \u2014   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mreads your staged     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdiff, writes the      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mcommit for you        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[2.5299, "o", "\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m2.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mvireo-pm              \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mVireo \u2014 lightweight   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m12 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mprocess manager &     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mresource guardian for \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mNode, Python and      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m     "]
[2.5299, "o", "                   \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mDocker. Memory limits,\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mleak detection,       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mcrash-loop breaking,  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37msmart restarts.       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m3.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m "]
[2.5299, "o", "\u001b[0m\u001b[32mhowlet                \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mFree, no-API-key      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m15 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mPython client + CLI + \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mBloomberg-style       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mterminal for SEC EDGAR\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdata                  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500"]
[2.5299, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m4.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mcetana                \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mAuditable BDI         \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m16 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m(belief-desire-intent\u2026\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37magents with LLM       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdeliberation \u2014        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                    "]
