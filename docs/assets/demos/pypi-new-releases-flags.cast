[3.995, "o", "\u001b[3m                                      Newly Released Packages                                       \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;35m \u001b[0m\u001b[1;35mIndex\u001b[0m\u001b[1;35m \u001b[0m\u2503\u001b[1;32m \u001b[0m\u001b[1;32mName                  \u001b[0m\u001b[1;32m \u001b[0m\u2503\u001b[1;31m \u001b[0m\u001b[1;31mAuthor                \u001b[0m\u001b[1;31m \u001b[0m\u2503\u001b[1;37m \u001b[0m\u001b[1;37mDescription          \u001b[0m\u001b[1;37m \u001b[0m\u2503\u001b[1;33m \u001b[0m\u001b[1;33mReleased At   \u001b[0m\u001b[1;33m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[35m \u001b[0m\u001b[35m1.   \u001b[0m\u001b[35"]
[3.995, "o", "m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32msema-mcp 0.8.0        \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31mmasihmoloodian@gmail.\u2026\u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mSemantic codebase    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mindexer and MCP      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mserver for Claude    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mCode                 \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[3.995, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m2.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mpretensor 0.1.0a4     \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m275843998+tensorcarlo\u2026\u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mPretensor database   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mknowledge graph \u2014    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mKuzu-backed schema   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mgraph from           \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mprecomputed DB       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m       "]
[3.995, "o", "                 \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mintrospection        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m3.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mdiscord-beacon 4.1.22 \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m                      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mInitialise a         \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mproduction-ready     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mDiscord.py bot in    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m "]
[3.9951, "o", "               \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mjust 4 lines of code \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37musing Beacon, the    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mmost advanced        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37munonionated framework\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mfor discord.py. Smart\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mand au"]
[3.9951, "o", "tomated command\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37msyncing,             \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mpreconditions (and   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mits presets),        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mcustomisable command \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mrate limits,         \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m              "]
[3.9951, "o", "          \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37measy-to-use          \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37min-Discord dashboard,\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mHelper Views, and    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mmore. A Dopamine     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mStudios project.     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[3.9951, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m4.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32manisama 1.1.1         \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m                      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mA CLI tool to browse,\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mwatch, and download  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n"]
