[4.124, "o", "11mreadme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=69768;https://github.com/textualize/rich/blob/master/README.pt-br.md\u001b\\\u001b[38;5;111mPortugu\u00eas brasileiro readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=801216;https://github.com/textualize/rich/blob/master/README.it.md\u001b\\\u001b[38;5;111mItalian readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=830789;https://github.com/textualize/rich/blob/master/README.ru.md\u001b\\\u001b[38;5;111m\u0420\u0443\u0441\u0441\u043a\u0438\u0439 readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=21983;https://github.com/textualize/rich/blob/master/README.id.md\u001b\\\u001b[38;5;111mIndonesian readme\u001b[0m\u001b]8;;\u001b\\ \u2022     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b]8;id=375236;https://github.com/textualize/rich/blob/master/README.fa.md\u001b\\\u001b[38;5;111m\u0641\u0627\u0631\u0633\u06cc readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=519541;https://github.com/textualize/rich/blob/master/README.tr.md\u001b\\\u001b[38;5;111mT\u00fcrk\u00e7e readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=172538;https://github.com/textualize/rich/blob/master/README.pl.md\u001b\\\u001b[38;5;111mPolskie readme\u001b[0m\u001b]8;;\u001b\\                                                    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                              "]
[4.1241, "o", "                                                    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Rich is a Python library for \u001b[3mrich\u001b[0m text and beautiful formatting in the terminal.                 \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m The \u001b]8;id=221616;https://rich.readthedocs.io/en/latest/\u001b\\\u001b[38;5;111mRich API\u001b[0m\u001b]8;;\u001b\\ makes it easy to add color and style to terminal output. Rich can also render       \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m pretty tables, progress bars, markdown, syntax highlighted source code, tracebacks, and more \u2014   \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m out of the box.                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \ud83c\udf06 \u001b]8;id=195883;https://github.com/textualize/rich/raw/master/imgs/features.png\u001b\\Fea"]
[4.1241, "o", "tures\u001b]8;;\u001b\\                                                                                      \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m For a video introduction to Rich see \u001b]8;id=214067;https://calmcode.io/rich/introduction.html\u001b\\\u001b[38;5;111mcalmcode.io\u001b[0m\u001b]8;;\u001b\\ by \u001b]8;id=756857;https://twitter.com/fishnets88\u001b\\\u001b[38;5;111m@fishnets88\u001b[0m\u001b]8;;\u001b\\.                                 \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m See what \u001b]8;id=677919;https://www.willmcgugan.com/blog/pages/post/rich-tweets/\u001b\\\u001b[38;5;111mpeople are saying about Rich\u001b[0m\u001b]8;;\u001b\\.                                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m              "]
[4.1241, "o", "                                                                                    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                          \u001b[1;4mCompatibility\u001b[0m                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Rich works with Linux, macOS and Windows. True color / emoji works with new Windows Terminal,    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m classic terminal is limited to 16 colors. Rich requires Python 3.8 or later.                     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Rich works with \u001b]8;id=467659;https://jupyter.org/\u001b\\\u001b[38;5;111mJupyter notebooks\u001b[0m\u001b]8;;\u001b\\ with no additional configuration required.                     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                          "]
[4.1242, "o", "                        \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                            \u001b[1;4mInstalling\u001b[0m                                            \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Install with \u001b[97;40mpip\u001b[0m or your favorite PyPI package manager.                                          \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;231;48;5;59mpython\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59m-m\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59mpip\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59minstall\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59mrich\u001b[0m\u001b[48;5;59m                                                                "]
[4.1242, "o", "      \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n"]
[4.3242, "o", "\r\n\u001b[2m\u2026 output truncated, run the command yourself to see the rest \u2026\u001b[0m\r\n"]
