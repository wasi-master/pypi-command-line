[4.2468, "o", "\u001b[1;35m\u256d\u2500\u001b[0m\u001b[1;35m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[1;35m Description for rich-rst \u001b[0m\u001b[1;35m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[1;35m\u2500\u256e\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Render \u001b]8;id=753163;https://docutils.sourceforge.io/rst.html\u001b\\\u001b[38;5;111mreStructuredText\u001b[0m\u001b]8;;\u001b\\ with \u001b]8;id=831769;https://rich.readthedocs.io/en/latest/\u001b\\\u001b[38;5;111mRich\u001b[0m\u001b]8;;\u001b\\. This package turns reST documents into Rich renderables so    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m you can preview documentation, docstrings, and snippets directly in the terminal. Also includes  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m a CLI.                                                                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                       "]
[4.2468, "o", "                                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                            \u001b[1;4mHighlights\u001b[0m                                            \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[1;33m \u2022 \u001b[0mSupports all currently documented RST elements.                                               \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[1;33m \u2022 \u001b[0mHandles common documentation features such as headings, lists, tables, links, images, code    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[1;33m   \u001b[0mblocks, footnotes, and many Sphinx roles.                                                     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[1;33m \u2022 \u001b[0mProvides both a Python API and a command-line interface.                                      \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[1;33m \u2022 \u001b[0mCan also export rendered output to HTML from the CLI.                                     "]
[4.2469, "o", "    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                           \u001b[1;4mInstallation\u001b[0m                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;231;48;5;59mpip\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59minstall\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59mrich-rst\u001b[0m\u001b[48;5;59m                                                                            \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                   "]
[4.2469, "o", "               \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                            \u001b[1;4mPython API\u001b[0m                                            \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;212;48;5;59mfrom\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59mrich\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;212;48;5;59mimport\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[3;38;5;159;48;5;59mprint\u001b[0m\u001b[48;5;59m                                                                          \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;212;48;5;59mfrom\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59mrich_rst\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;212;48;5;59mimport\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;231;48;5;59mRestructuredText\u001b[0m\u001b[48;5;59m                                                           \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[48;5;59m                                                                                              "]
[4.2469, "o", "  \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;231;48;5;59mdocument\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;212;48;5;59m=\u001b[0m\u001b[38;5;231;48;5;59m \u001b[0m\u001b[38;5;183;48;5;59m\"\"\"\u001b[0m\u001b[48;5;59m                                                                                  \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59mrich-rst\u001b[0m\u001b[48;5;59m                                                                                        \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59m========\u001b[0m\u001b[48;5;59m                                                                                        \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[48;5;59m                                                                                                \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59mThis is a **test** document.\u001b[0m\u001b[48;5;59m                                                                    \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[48;5;59m                                                                                  "]
[4.2469, "o", "              \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59m- Item one\u001b[0m\u001b[48;5;59m                                                                                      \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59m- Item two\u001b[0m\u001b[48;5;59m                                                                                      \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[48;5;59m                                                                                                \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59m.. code-block:: python\u001b[0m\u001b[48;5;59m                                                                          \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[48;5;59m                                                                                                \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59m   print(\u001b[0m\u001b[38;5;183;48;5;59m\"\u001b[0m\u001b[38;5;183;48;5;59mhello\u001b[0m\u001b[38;5;183;48;5;59m\"\u001b[0m\u001b[38;5;183;48;5;59m)\u001b[0m\u001b[48;5;59m                                                     "]
[4.2469, "o", "                          \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;183;48;5;59m\"\"\"\u001b[0m\u001b[48;5;59m                                                                                             \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n"]
