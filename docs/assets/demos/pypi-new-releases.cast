[2.7018, "o", "m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32msema-mcp 0.8.0        \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mSemantic codebase     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mindexer and MCP server\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mfor Claude Code       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m2.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mpretensor 0.1.0a4     \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mPretensor database    \u001b[0m\u001b[37m \u001b[0m\u2502"]
[2.7019, "o", "\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mknowledge graph \u2014     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mKuzu-backed schema    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mgraph from precomputed\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mDB introspection      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[2.7019, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m3.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mdiscord-beacon 4.1.22 \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mInitialise a          \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mproduction-ready      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mDiscord.py bot in just\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m4 lines of code using \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mBeacon, the most      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33"]
[2.7019, "o", "m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37madvanced unonionated  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mframework for         \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdiscord.py. Smart and \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mautomated command     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37msyncing, preconditions\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m(and its presets),    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b"]
[2.7019, "o", "[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mcustomisable command  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mrate limits,          \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37measy-to-use in-Discord\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdashboard, Helper     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mViews, and more. A    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mDo"]
[2.7019, "o", "pamine Studios      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mproject.              \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m4.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32manisama 1.1.1         \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mA CLI tool to browse, \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mhttps://pypi.org/pro\u2026\u001b[0m\u001b[36m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m7 minutes ago \u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mwatch, and download   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       "]
[2.7019, "o", "\u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37manime from Anime-Sama \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m(VOSTFR/VF)           \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[36m                       \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n"]
