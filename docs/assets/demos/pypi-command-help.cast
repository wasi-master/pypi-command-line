[2.2385, "o", "\u001b[2m\u256d\u2500\u001b[0m\u001b[2m Arguments \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u256e\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[31m*\u001b[0m    package_name      \u001b[1;33mTEXT\u001b[0m  The name of the package to show information for \u001b[2;31m[required]\u001b[0m          \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
[2.2432, "o", "\u001b[2m\u256d\u2500\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u256e\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-version\u001b[0m                                        \u001b[1;33mTEXT        \u001b[0m  The version of the package to     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                show info for                     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-show\u001b[0m\u001b[1;36m-classifiers\u001b[0m     \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-show-classifiers\u001b[0m     \u001b[1;33mclassifiers \u001b[0m  Show the classifiers              \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-show-classifiers]\u001b[0m    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-hide\u001b[0m\u001b[1;36m-project-urls\u001b[0m    \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-"]
[2.2432, "o", "hide-project-urls\u001b[0m    \u001b[1;33mproject_urls\u001b[0m  Hide the project urls             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-hide-project-urls]\u001b[0m   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-hide\u001b[0m\u001b[1;36m-requirements\u001b[0m    \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-hide-requirements\u001b[0m    \u001b[1;33mrequirements\u001b[0m  Hide the requirements             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-hide-requirements]\u001b[0m   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-hide\u001b[0m\u001b[1;36m-github\u001b[0m          \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-hide-github\u001b[0m          \u001b[1;33mgithub      \u001b[0m  Hide the github                   \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-hide-github]\u001b[0m         \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-hide\u001b[0m\u001b[1;36m-stats\u001b[0m           \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-hide-stats\u001b[0m           \u001b[1;33mstats"]
[2.2432, "o", "       \u001b[0m  Hide the stats                    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-hide-stats]\u001b[0m          \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-hide\u001b[0m\u001b[1;36m-meta\u001b[0m            \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-hide-meta\u001b[0m            \u001b[1;33mmeta        \u001b[0m  Hide the metadata                 \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-hide-meta]\u001b[0m           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-full\u001b[0m\u001b[1;36m-description\u001b[0m     \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-full-description\u001b[0m     \u001b[1;33m            \u001b[0m  Show the full description instead \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                of truncating                     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                \u001b[2m[default: no-full-description]   \u001b[0m \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-json\u001b[0m              "]
[2.2432, "o", "                             \u001b[1;33m            \u001b[0m  Output the package metadata as    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                                JSON instead of rendering it      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m                                           \u001b[1;33m            \u001b[0m  Show this message and exit.       \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
[2.2432, "o", "\r\n"]
