[2.2369, "o", "\u001b[1m                                                                                                    \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mpypi information [OPTIONS] PACKAGE_NAME\u001b[0m\u001b[1m                                                    \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                    \u001b[0m\r\n"]
