[6.0149, "o", "[0m \u001b[38;5;136mAuthor\u001b[0m: Will McGugan                           \u001b[38;5;226m\u2502\u001b[0m\u001b[1;35m\u2502\u001b[0m Rich is a Python library for \u001b[3mrich\u001b[0m text and     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[38;5;226m\u2502\u001b[0m \u001b[38;5;136mAuthor Email\u001b[0m: willmcgugan@gmail.com            \u001b[38;5;226m\u2502\u001b[0m\u001b[1;35m\u2502\u001b[0m beautiful formatting in the terminal.          \u001b[1;35m\u2502\u001b[0m\r\n\u001b[38;5;226m\u2502\u001b[0m \u001b[38;5;136mRequires Python\u001b[0m: >=3.9.0                       \u001b[38;5;226m\u2502\u001b[0m\u001b[1;35m\u2502\u001b[0m                                                \u001b[1;35m\u2502\u001b[0m\r\n\u001b[38;5;226m\u2502\u001b[0m \u001b[38;5;136mOwner:\u001b[0m willmcgugan                             \u001b[38;5;226m\u2502\u001b[0m\u001b[1;35m\u2502\u001b[0m The \u001b]8;id=718973;https://rich.readthedocs.io/en/latest/\u001b\\\u001b[38;5;111mRich API\u001b[0m\u001b]8;;\u001b\\ makes it easy to add color and    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[38;5;226m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\u001b[1;35m\u2502\u001b[0m style to terminal output. Rich can also render \u001b[1;35m\u2502\u001b[0m\r\n    "]
[6.0149, "o", "                                              \u001b[1;35m\u2502\u001b[0m pretty tables, progress bars, markdown, syntax \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m highlighted source code, tracebacks, and more  \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m \u2014 out of the box.                              \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m                                                \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m \ud83c\udf06 \u001b]8;id=93294;https://github.com/textualize/rich/raw/master/imgs/features.png\u001b\\Features\u001b]8;;\u001b\\                                    \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m                                                \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m For a video introduction to Rich see           \u001b[1;35m\u2502\u001b[0m\r\n                                           "]
[6.0149, "o", "       \u001b[1;35m\u2502\u001b[0m \u001b]8;id=350107;https://calmcode.io/rich/introduction.html\u001b\\\u001b[38;5;111mcalmcode.io\u001b[0m\u001b]8;;\u001b\\ by \u001b]8;id=771718;https://twitter.com/fishnets88\u001b\\\u001b[38;5;111m@fishnets88\u001b[0m\u001b]8;;\u001b\\.                    \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m                                                \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m See what \u001b]8;id=911655;https://www.willmcgugan.com/blog/pages/post/rich-tweets/\u001b\\\u001b[38;5;111mpeople are saying about Rich\u001b[0m\u001b]8;;\u001b\\.         \u001b[1;35m\u2502\u001b[0m\r\n"]
