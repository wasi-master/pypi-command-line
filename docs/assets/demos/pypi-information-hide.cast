[7.2303, "o", "                                              \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m The \u001b]8;id=835868;https://rich.readthedocs.io/en/latest/\u001b\\\u001b[38;5;111mRich API\u001b[0m\u001b]8;;\u001b\\ makes it easy to add color and    \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m style to terminal output. Rich can also render \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m pretty tables, progress bars, markdown, syntax \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m highlighted source code, tracebacks, and more  \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m \u2014 out of the box.                              \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m                                                \u001b[1;35m\u2502\u001b[0m\r\n                                                  \u001b[1;35m\u2502\u001b[0m \ud83c\udf06 \u001b]8;id=424364;https://github.com/textualize/ri"]
