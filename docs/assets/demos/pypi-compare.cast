[5.2001, "o", "\u001b[3m                     \u001b[0m\u001b[1;3mPyPI Package Comparison\u001b[0m\u001b[3m                      \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;36m \u001b[0m\u001b[1;36mMetric\u001b[0m\u001b[1;36m           \u001b[0m\u001b[1;36m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1m  \u001b[0m\u001b[1;32mrequests\u001b[0m\u001b[1m  \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1m   \u001b[0m\u001b[1;32mhttpx\u001b[0m\u001b[1m    \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1m  \u001b[0m\u001b[1;32maiohttp\u001b[0m\u001b[1m   \u001b[0m\u001b[1m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[36m \u001b[0m\u001b[36mLatest Version   \u001b[0m\u001b[36m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m   2.34.2   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m   0.28.1   \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m   3.14.1   \u001b[0m\u001b[37m \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
