[3.9272, "o", "\u001b[3m                                        Newly Added Packages                                        \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;35m \u001b[0m\u001b[1;35mIndex\u001b[0m\u001b[1;35m \u001b[0m\u2503\u001b[1;32m \u001b[0m\u001b[1;32mName                  \u001b[0m\u001b[1;32m \u001b[0m\u2503\u001b[1;31m \u001b[0m\u001b[1;31mAuthor                \u001b[0m\u001b[1;31m \u001b[0m\u2503\u001b[1;37m \u001b[0m\u001b[1;37mDescription          \u001b[0m\u001b[1;37m \u001b[0m\u2503\u001b[1;33m \u001b[0m\u001b[1;33mPublished At  \u001b[0m\u001b[1;33m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[35m \u001b[0m\u001b[35m1.   \u001b[0m\u001b[35"]
[3.9272, "o", "m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mcommitstash           \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m                      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mAI-powered git commit\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m10 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mmessage generator \u2014  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mreads your staged    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdiff, writes the     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mcommit for you       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[3.9273, "o", "\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m2.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mvireo-pm              \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m                      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mVireo \u2014 lightweight  \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m12 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mprocess manager &    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mresource guardian for\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mNode, Python and     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m         "]
[3.9273, "o", "               \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mDocker. Memory       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mlimits, leak         \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdetection, crash-loop\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mbreaking, smart      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mrestarts.            \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[3.9273, "o", "\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m3.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mhowlet                \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m                      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mFree, no-API-key     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m15 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mPython client + CLI +\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mBloomberg-style      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mterminal for SEC     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mEDGAR da"]
[3.9273, "o", "ta           \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m4.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mcetana                \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31mkarurpabe@gmail.com   \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mAuditable BDI        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m16 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37m(belief-desire-inten\u2026\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37magents with LLM      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m"]
[3.9273, "o", "\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mdeliberation \u2014       \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mexplicit beliefs,    \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mcommitted intentions,\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mand a trace that     \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37manswers 'why'        \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500"]
[3.9274, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[35m \u001b[0m\u001b[35m5.   \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32mpurepix               \u001b[0m\u001b[32m \u001b[0m\u2502\u001b[31m \u001b[0m\u001b[31m                      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mPure-Python,         \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m17 minutes ago\u001b[0m\u001b[33m \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mzero-dependency image\u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n\u2502\u001b[35m       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\u001b[31m                        \u001b[0m\u2502\u001b[37m \u001b[0m\u001b[37mlibrary: codecs      \u001b[0m\u001b[37m \u001b[0m\u2502\u001b[33m                \u001b[0m\u2502\r\n"]
[4.1274, "o", "\r\n\u001b[2m\u2026 output truncated, run the command yourself to see the rest \u2026\u001b[0m\r\n"]
