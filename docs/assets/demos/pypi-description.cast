[2.7727, "o", "11mreadme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=79893;https://github.com/textualize/rich/blob/master/README.pt-br.md\u001b\\\u001b[38;5;111mPortugu\u00eas brasileiro readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=846608;https://github.com/textualize/rich/blob/master/README.it.md\u001b\\\u001b[38;5;111mItalian readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=211251;https://github.com/textualize/rich/blob/master/README.ru.md\u001b\\\u001b[38;5;111m\u0420\u0443\u0441\u0441\u043a\u0438\u0439 readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=723695;https://github.com/textualize/rich/blob/master/README.id.md\u001b\\\u001b[38;5;111mIndonesian readme\u001b[0m\u001b]8;;\u001b\\ \u2022     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b]8;id=268156;https://github.com/textualize/rich/blob/master/README.fa.md\u001b\\\u001b[38;5;111m\u0641\u0627\u0631\u0633\u06cc readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=17749;https://github.com/textualize/rich/blob/master/README.tr.md\u001b\\\u001b[38;5;111mT\u00fcrk\u00e7e readme\u001b[0m\u001b]8;;\u001b\\ \u2022 \u001b]8;id=39665;https://github.com/textualize/rich/blob/master/README.pl.md\u001b\\\u001b[38;5;111mPolskie readme\u001b[0m\u001b]8;;\u001b\\                                                    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                               "]
[2.7727, "o", "                                                   \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Rich is a Python library for \u001b[3mrich\u001b[0m text and beautiful formatting in the terminal.                 \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m The \u001b]8;id=409485;https://rich.readthedocs.io/en/latest/\u001b\\\u001b[38;5;111mRich API\u001b[0m\u001b]8;;\u001b\\ makes it easy to add color and style to terminal output. Rich can also render       \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m pretty tables, progress bars, markdown, syntax highlighted source code, tracebacks, and more \u2014   \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m out of the box.                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \ud83c\udf06 \u001b]8;id=584750;https://github.com/textualize/rich/raw/master/imgs/features.png\u001b\\Feat"]
[2.7727, "o", "ures\u001b]8;;\u001b\\                                                                                      \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m For a video introduction to Rich see \u001b]8;id=869536;https://calmcode.io/rich/introduction.html\u001b\\\u001b[38;5;111mcalmcode.io\u001b[0m\u001b]8;;\u001b\\ by \u001b]8;id=496500;https://twitter.com/fishnets88\u001b\\\u001b[38;5;111m@fishnets88\u001b[0m\u001b]8;;\u001b\\.                                 \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m See what \u001b]8;id=35076;https://www.willmcgugan.com/blog/pages/post/rich-tweets/\u001b\\\u001b[38;5;111mpeople are saying about Rich\u001b[0m\u001b]8;;\u001b\\.                                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                "]
[2.7727, "o", "                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                          \u001b[1;4mCompatibility\u001b[0m                                           \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Rich works with Linux, macOS and Windows. True color / emoji works with new Windows Terminal,    \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m classic terminal is limited to 16 colors. Rich requires Python 3.8 or later.                     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Rich works with \u001b]8;id=549052;https://jupyter.org/\u001b\\\u001b[38;5;111mJupyter notebooks\u001b[0m\u001b]8;;\u001b\\ with no additional configuration required.                     \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                            "]
[2.7727, "o", "                      \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                            \u001b[1;4mInstalling\u001b[0m                                            \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m Install with \u001b[97;40mpip\u001b[0m or your favorite PyPI package manager.                                          \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m                                                                                                  \u001b[1;35m\u2502\u001b[0m\r\n\u001b[1;35m\u2502\u001b[0m \u001b[38;5;231;48;5;235mpython\u001b[0m\u001b[38;5;231;48;5;235m \u001b[0m\u001b[38;5;231;48;5;235m-m\u001b[0m\u001b[38;5;231;48;5;235m \u001b[0m\u001b[38;5;231;48;5;235mpip\u001b[0m\u001b[38;5;231;48;5;235m \u001b[0m\u001b[38;5;231;48;5;235minstall\u001b[0m\u001b[38;5;231;48;5;235m \u001b[0m\u001b[38;5;231;48;5;235mrich\u001b[0m\u001b[48;5;235m                                                        "]
[2.7727, "o", "              \u001b[0m \u001b[1;35m\u2502\u001b[0m\r\n"]
[2.9727, "o", "\r\n\u001b[2m\u2026 output truncated, run the command yourself to see the rest \u2026\u001b[0m\r\n"]
[3.4727, "o", "\r\n\u001b[1;35m~\u001b[0m \u001b[1;32m\u276f\u001b[0m "]
