[1.959, "o", "\u001b[1m                                                                                                    \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mpypi [OPTIONS] COMMAND [ARGS]...\u001b[0m\u001b[1m                                                           \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                    \u001b[0m\r\n"]
[1.9591, "o", " A beautiful command line interface for the Python Package Index                                    \r\n                                                                                                    \r\n"]
[1.9624, "o", "\u001b[2m\u256d\u2500\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u256e\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-cache\u001b[0m                   \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-cache\u001b[0m    \u001b[1;33m                    \u001b[0m  Whether to use cache or not        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               \u001b[2m[default: cache]           \u001b[0m        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-repository\u001b[0m                            \u001b[1;33mTEXT                \u001b[0m  The repository to fetch the        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               information from. Either           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               'testpypi' or a full URL like      \u001b[2m"]
[1.9624, "o", "\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               'https://test.pypi.org'            \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-timeout\u001b[0m                               \u001b[1;33mFLOAT RANGE [x>=0.1\u001b[0m\u001b[1;2;33m]\u001b[0m  Timeout in seconds for network     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               requests                           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               \u001b[2m[default: 15.0]                   \u001b[0m \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-verbose\u001b[0m             \u001b[1;32m-v\u001b[0m                \u001b[1;33m                    \u001b[0m  Show debug logs for errors that    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               are otherwise silently ignored     \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-install\u001b[0m\u001b[1;36m-completion\u001b[0m                    \u001b[1;33m                    \u001b[0m  Install completion for the current \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m        "]
[1.9624, "o", "                                                       shell.                             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-show\u001b[0m\u001b[1;36m-completion\u001b[0m                       \u001b[1;33m                    \u001b[0m  Show completion for the current    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               shell, to copy it or customize the \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m                                                               installation.                      \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m                                  \u001b[1;33m                    \u001b[0m  Show this message and exit.        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
[1.9643, "o", "\u001b[2m\u256d\u2500\u001b[0m\u001b[2m Commands \u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[2m\u2500\u256e\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mdescription     \u001b[0m\u001b[1;36m \u001b[0m See the description for a package.                                             \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mnew-packages    \u001b[0m\u001b[1;36m \u001b[0m See the top 40 newly added packages.                                           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mnew-releases    \u001b[0m\u001b[1;36m \u001b[0m See the top 100 newly updated packages.                                        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mlargest-files   \u001b[0m\u001b[1;36m \u001b[0m See the top 100 projects with the largest file size.                           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36msearch          \u001b[0m\u001b[1;36m \u001b[0m Search for a package on PyPI. Currently not available                          \u001b[2"]
[1.9643, "o", "m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mreleases        \u001b[0m\u001b[1;36m \u001b[0m See all the available releases for a package.                                  \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mvulnerabilities \u001b[0m\u001b[1;36m \u001b[0m See all the known vulnerabilities for a package.                               \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mwheels          \u001b[0m\u001b[1;36m \u001b[0m See detailed information about all the wheels of a release of a package        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mcheck           \u001b[0m\u001b[1;36m \u001b[0m Check a requirements.txt or pyproject.toml file for updates, wheel support,    \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36m                 \u001b[0m and abandoned packages.                                                        \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36minformation     \u001b[0m\u001b[1;36m \u001b[0m See the information about a package.                                           \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;36mregex-search    \u001b[0m\u001b[1;36m \u001b[0m Search for packages that match the regular expression.                         \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[1;3"]
[1.9643, "o", "6mread-the-docs   \u001b[0m\u001b[1;36m \u001b[0m Search the documentation for an item of a package.                             \u001b[2m\u2502\u001b[0m\r\n"]
[2.1643, "o", "\r\n\u001b[2m\u2026 output truncated, run the command yourself to see the rest \u2026\u001b[0m\r\n"]
[2.6643, "o", "\r\n\u001b[1;35m~\u001b[0m \u001b[1;32m\u276f\u001b[0m "]
