[3.6713, "o", "\u001b[3m                                  Known Vulnerabilities for django                                  \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1;31m \u001b[0m\u001b[1;31mID                 \u001b[0m\u001b[1;31m \u001b[0m\u2503\u001b[1;33m \u001b[0m\u001b[1;33mDetails                \u001b[0m\u001b[1;33m \u001b[0m\u2503\u001b[1;35m \u001b[0m\u001b[1;35mAliases                \u001b[0m\u001b[1;35m \u001b[0m\u2503\u001b[1;32m \u001b[0m\u001b[1;32mFixed in              \u001b[0m\u001b[1;32m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[31m \u001b[0m\u001b]8;id=247178;https://osv.dev/vulnerability/PYSEC-202"]
[3.6714, "o", "1-8\u001b\\\u001b[31mPYSEC-2021-8\u001b[0m\u001b]8;;\u001b\\\u001b[31m       \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mIn Django 2.2 before   \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m \u001b[0m\u001b[35mCVE-2021-32052,        \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32m2.2.22, 3.1.10, 3.2.2 \u001b[0m\u001b[32m \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m2.2.22, 3.1 before     \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m \u001b[0m\u001b[35mGHSA-qm57-vhq3-3fwf    \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m3.1.10, and 3.2 before \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m3.2.2 (with Python     \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m3.9.5+), URLValidator  \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mdoes not prohibit      \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                  "]
[3.6715, "o", "       \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mnewlines and tabs      \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m(unless the URLField   \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mform field is used). If\u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33man application uses    \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mvalues with newlines in\u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33man HTTP response,      \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m         "]
[3.6715, "o", "               \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mheader injection can   \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33moccur. Django itself is\u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33munaffected because     \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mHttpResponse prohibits \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mnewlines in HTTP       \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mheaders.               \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u251c"]
[3.6715, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\n\u2502\u001b[31m \u001b[0m\u001b]8;id=354326;https://osv.dev/vulnerability/PYSEC-2021-98\u001b\\\u001b[31mPYSEC-2021-98\u001b[0m\u001b]8;;\u001b\\\u001b[31m      \u001b[0m\u001b[31m \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mDjango before 2.2.24,  \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m \u001b[0m\u001b[35mCVE-2021-33203,        \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m \u001b[0m\u001b[32m2.2.24, 3.1.12, 3.2.4 \u001b[0m\u001b[32m \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m3.x before 3.1.12, and \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m \u001b[0m\u001b[35mGHSA-68w8-qjq3-2gfm    \u001b[0m\u001b[35m \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m3.2.x before 3.2.4 has \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33ma potential directory  \u001b[0m\u001b[3"]
[3.6715, "o", "3m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mtraversal via          \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mdjango.contrib.admindo\u2026\u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mStaff members could use\u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mthe TemplateDetailView \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mview to check the      \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mexistence of arbitrary \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m           "]
[3.6715, "o", "              \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mfiles. Additionally, if\u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33m(and only if) the      \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mdefault admindocs      \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mtemplates have been    \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mcustomized by          \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m                        \u001b[0m\u2502\r\n\u2502\u001b[31m                     \u001b[0m\u2502\u001b[33m \u001b[0m\u001b[33mapplication developers \u001b[0m\u001b[33m \u001b[0m\u2502\u001b[35m                         \u001b[0m\u2502\u001b[32m  "]
